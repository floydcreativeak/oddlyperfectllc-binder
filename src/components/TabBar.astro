---
/**
 * Mobile only: the bottom tab bar (binder tabs) with a floating Call button
 * docked above it. Safe-area aware; every target is at least 44px.
 */
import Icon from './Icon.astro';
import { telHref, type Site } from '~/lib/content';
import { isActive, link } from '~/lib/nav';

interface Props { site: Site }
const { site } = Astro.props;
const path = Astro.url.pathname;
---
<div class="tabbar-wrap">
  <a
    class="fab-call"
    href={telHref(site)}
    aria-label={`${site.microcopy.phoneAria} ${site.phone.display}`}
    data-placeholder={site.phone.placeholder ? 'phone' : undefined}
  >
    <Icon name="phone" />
    <span aria-hidden="true">{site.microcopy.callLabel}</span>
  </a>
  <nav class="tabbar" aria-label={site.microcopy.tabBarLabel}>
    <ul role="list">
      {site.nav.map((item) => {
        const active = isActive(item.href, path);
        return (
          <li>
            <a href={link(item.href)} class="tabbar__link" aria-current={active ? 'page' : undefined}>
              <Icon name={item.icon} />
              <span>{item.label}</span>
            </a>
          </li>
        );
      })}
    </ul>
  </nav>
</div>

<style>
  .tabbar-wrap {
    position: fixed;
    inset: auto 0 0 0;
    z-index: var(--z-tabbar);
    pointer-events: none;
    view-transition-name: tabbar;
  }
  .tabbar {
    pointer-events: auto;
    padding: 0.3rem max(0.4rem, env(safe-area-inset-left)) calc(0.3rem + env(safe-area-inset-bottom)) max(0.4rem, env(safe-area-inset-right));
    background: var(--glass);
    -webkit-backdrop-filter: blur(14px) saturate(1.3);
    backdrop-filter: blur(14px) saturate(1.3);
    box-shadow: 0 -1px 0 var(--glass-border), 0 -6px 20px rgb(var(--shadow-color) / 0.08);
  }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .tabbar { background: var(--surface); }
  }
  .tabbar ul { display: grid; grid-template-columns: repeat(5, 1fr); }
  .tabbar__link {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.1rem;
    min-height: 3.4rem;
    padding: 0.2rem 0;
    border-radius: var(--radius-s);
    color: var(--ink-soft);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .tabbar__link :global(.icon) { width: 1.45rem; height: 1.45rem; transition: transform var(--dur-spring) var(--ease-spring); }
  .tabbar__link:active :global(.icon) { transform: scale(0.85); }
  .tabbar__link[aria-current='page'] { color: var(--ink); font-weight: 700; }
  .tabbar__link[aria-current='page'] :global(.icon) { transform: translateY(calc(-2px * var(--motion-distance))) rotate(-6deg); color: var(--accent-ink); }
  /* The active "binder tab": a coral notch along the top edge + dot. */
  .tabbar__link::before {
    content: '';
    position: absolute;
    top: -0.3rem;
    left: 50%;
    width: 1.8rem;
    height: 0.3rem;
    margin-left: -0.9rem;
    border-radius: 0 0 6px 6px;
    background: var(--accent);
    transform: scaleX(0);
    transition: transform var(--dur-spring) var(--ease-spring);
  }
  .tabbar__link[aria-current='page']::before { transform: scaleX(1); }

  .fab-call {
    pointer-events: auto;
    position: absolute;
    right: max(var(--gutter), env(safe-area-inset-right));
    bottom: calc(100% + 0.75rem);
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 3.25rem;
    padding: 0 1.25rem 0 1.05rem;
    border-radius: var(--radius-pill);
    background: var(--accent-ink);
    color: var(--on-accent);
    font-weight: 800;
    font-size: 1.05rem;
    text-decoration: none;
    box-shadow: 0 0 0 3px var(--surface), var(--shadow-3);
    transform: rotate(-3deg);
    transition: transform var(--dur-spring) var(--ease-spring);
    -webkit-tap-highlight-color: transparent;
  }
  .fab-call :global(.icon) { width: 1.35rem; height: 1.35rem; }
  .fab-call:active { transform: rotate(-3deg) scale(var(--squish)); }
  @media (prefers-reduced-motion: no-preference) {
    .fab-call { animation: fab-wiggle 1s var(--ease-in-out) 2.5s 1 backwards; }
    @keyframes fab-wiggle {
      0%, 100% { transform: rotate(-3deg); }
      25% { transform: rotate(4deg) scale(1.05); }
      55% { transform: rotate(-7deg) scale(1.05); }
      80% { transform: rotate(0deg); }
    }
  }

  @media (min-width: 60em) {
    .tabbar-wrap { display: none; }
  }
</style>
