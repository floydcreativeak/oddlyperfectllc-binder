---
/** Closing call to action used at the bottom of inner pages. */
import Icon from './Icon.astro';
import { telHref, mailHref, type Site } from '~/lib/content';
interface Props { site: Site; heading: string; body: string }
const { site, heading, body } = Astro.props;
---
<section class="cta container" aria-labelledby="cta-title">
  <div class="cta__card">
    <h2 id="cta-title" class="cta__title">{heading}</h2>
    <p class="cta__body">{body}</p>
    <div class="cta__actions">
      <a class="btn" href={telHref(site)} data-placeholder={site.phone.placeholder ? 'phone' : undefined}><Icon name="phone" />{site.microcopy.callLong}: {site.phone.display}</a>
      <a class="btn btn--ghost" href={mailHref(site)} data-placeholder={site.email.placeholder ? 'email' : undefined}><Icon name="mail" />{site.microcopy.emailLabel}</a>
    </div>
  </div>
</section>

<style>
  .cta { margin-top: var(--space-3xl); }
  .cta__card { padding: clamp(1.75rem, 1rem + 4vw, 4rem); border-radius: var(--radius-l); background: var(--whiteboard); border: 10px solid var(--whiteboard-rim); box-shadow: var(--shadow-2); text-align: center; }
  .cta__title { font-size: var(--step-4); max-width: 18ch; margin-inline: auto; }
  .cta__body { margin: var(--space-s) auto 0; font-size: var(--step-1); color: var(--ink-soft); }
  .cta__actions { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-s); margin-top: var(--space-l); }
</style>
