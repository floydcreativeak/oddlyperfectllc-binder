---
/**
 * Glass header. Desktop: logo, page links (active dot), phone, socials, theme.
 * Mobile: slim bar with logo, phone and theme (links move to the tab bar).
 * Hides on scroll down, returns on scroll up (src/scripts/shell.ts).
 */
import Logo from './Logo.astro';
import PhoneLink from './PhoneLink.astro';
import ThemeToggle from './ThemeToggle.astro';
import Icon from './Icon.astro';
import type { Site } from '~/lib/content';
import { isActive } from '~/lib/nav';

interface Props { site: Site }
const { site } = Astro.props;
const path = Astro.url.pathname;
const socialIcon = (p: string) => (['facebook', 'instagram', 'linkedin'].includes(p) ? (p as 'facebook') : 'link');
---
<header class="site-header" data-header>
  <div class="site-header__inner">
    <Logo site={site} compact />

    <nav class="site-nav" aria-label={site.microcopy.menuLabel}>
      <ul role="list">
        {site.nav.map((item) => {
          const active = isActive(item.href, path);
          return (
            <li>
              <a href={item.href} aria-current={active ? 'page' : undefined} class="site-nav__link">
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="site-header__actions">
      <PhoneLink site={site} class="site-header__phone" />
      <ul class="site-header__socials" role="list" aria-label={site.microcopy.socialsLabel}>
        {site.socials.map((s) => (
          <li>
            <a href={s.url} class="site-header__social" rel="me noopener" target="_blank" data-placeholder={s.placeholder ? 'social' : undefined}>
              <Icon name={socialIcon(s.platform)} />
              <span class="visually-hidden">{s.label} (opens in a new tab)</span>
            </a>
          </li>
        ))}
      </ul>
      <ThemeToggle site={site} />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-nav);
    padding-top: env(safe-area-inset-top);
    background: var(--glass);
    -webkit-backdrop-filter: blur(14px) saturate(1.3);
    backdrop-filter: blur(14px) saturate(1.3);
    box-shadow: 0 1px 0 var(--glass-border);
    transition: transform var(--dur-slow) var(--ease-out), box-shadow var(--dur-base) var(--ease-out);
    view-transition-name: site-header;
  }
  .site-header[data-hidden='true'] { transform: translateY(-110%); }
  .site-header[data-scrolled='true'] { box-shadow: 0 1px 0 var(--glass-border), var(--shadow-1); }
  @media (prefers-reduced-motion: reduce) {
    .site-header[data-hidden='true'] { transform: none; }
  }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .site-header { background: var(--surface); }
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    width: min(100% - 2 * var(--gutter), calc(var(--content-max) + 8rem));
    min-height: var(--nav-h-mobile);
    margin-inline: auto;
  }

  /* ── Page links (desktop) ── */
  .site-nav { display: none; }
  .site-nav ul { display: flex; gap: var(--space-3xs); }
  .site-nav__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding: 0 0.85rem;
    border-radius: var(--radius-pill);
    font-weight: 600;
    text-decoration: none;
    color: var(--ink);
    transition: background-color var(--dur-fast) var(--ease-out);
  }
  .site-nav__link:hover { background: var(--surface-2); }
  .site-nav__link::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0.32rem;
    width: 0.42rem;
    height: 0.42rem;
    margin-left: -0.21rem;
    border-radius: 50%;
    background: var(--accent);
    transform: scale(0);
    transition: transform var(--dur-spring) var(--ease-spring);
  }
  .site-nav__link[aria-current='page']::after { transform: scale(1); }
  .site-nav__link[aria-current='page'] { font-weight: 700; }

  /* ── Actions ── */
  .site-header__actions { display: flex; align-items: center; gap: var(--space-3xs); }
  .site-header__actions :global(.site-header__phone) {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: var(--tap);
    padding: 0 0.7rem;
    border-radius: var(--radius-pill);
    color: var(--accent-ink);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color var(--dur-fast) var(--ease-out), transform var(--dur-spring) var(--ease-spring);
  }
  .site-header__actions :global(.site-header__phone:hover) { background: var(--surface-2); transform: rotate(calc(-2deg * var(--motion-distance))); }
  .site-header__actions :global(.site-header__phone:active) { transform: scale(var(--squish)); }

  .site-header__socials { display: none; }
  .site-header__social {
    display: inline-grid;
    place-items: center;
    width: var(--tap);
    height: var(--tap);
    border-radius: var(--radius-pill);
    color: var(--ink);
    transition: background-color var(--dur-fast) var(--ease-out), transform var(--dur-spring) var(--ease-spring);
  }
  .site-header__social:hover { background: var(--surface-2); transform: rotate(calc(8deg * var(--motion-distance))); }

  /* Tiny phones: number only, drop the icon so it never wraps. */
  @media (max-width: 30em) {
    .site-header__inner { gap: 0.4rem; }
    .site-header__actions { gap: 0; }
    .site-header__actions :global(.site-header__phone) { padding: 0 0.4rem; font-size: 0.95rem; gap: 0.3rem; }
  }
  @media (max-width: 24.5em) {
    .site-header__actions :global(.site-header__phone .icon) { display: none; }
  }

  @media (min-width: 60em) {
    .site-header__inner { min-height: var(--nav-h); }
    .site-nav { display: block; }
    .site-header__socials { display: flex; }
    .site-header__actions :global(.site-header__phone) {
      margin-right: var(--space-2xs);
      background: var(--note-butter);
      color: var(--note-ink);
      border-radius: var(--radius-note);
      box-shadow: var(--shadow-note);
      transform: rotate(-1.5deg);
    }
    .site-header__actions :global(.site-header__phone:hover) { background: var(--note-butter); transform: rotate(1deg) translateY(calc(-2px * var(--motion-distance))); }
  }
  @media (min-width: 60em) and (max-width: 72em) {
    .site-header__socials { display: none; }
  }
</style>
