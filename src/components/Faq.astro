---
/** Accessible FAQ accordion built on <details>/<summary>: keyboard and screen-reader friendly with no JS. */
import { getFaq, getPricing, getSite, fill } from '~/lib/content';
const [faq, pricing, site] = await Promise.all([getFaq(), getPricing(), getSite()]);
interface Props { headingId: string }
const { headingId } = Astro.props;
---
<div class="faq">
  <header class="faq__head">
    {faq.kicker && <p class="kicker">{faq.kicker}</p>}
    <h2 id={headingId}>{faq.heading}</h2>
  </header>
  <div class="faq__list">
    {faq.items.map((item) => (
      <details class="faq__item">
        <summary>
          <span>{item.question}</span>
          <svg class="faq__plus" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12.2 4.5c-.2 5-.3 10-.1 15M4.6 12.1c5-.2 9.9-.2 14.9.1" /></svg>
        </summary>
        <div class="faq__answer"><p>{fill(item.answer, pricing, site)}</p></div>
      </details>
    ))}
  </div>
</div>

<style>
  .faq { display: grid; gap: var(--space-xl); }
  .faq__list { display: grid; gap: var(--space-s); }
  .faq__item { border-radius: var(--radius-m); background: var(--surface); box-shadow: var(--shadow-1); transition: box-shadow var(--dur-base) var(--ease-out); }
  .faq__item[open] { box-shadow: var(--shadow-2); }
  .faq__item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.5rem;
    padding: 1rem 1.25rem;
    font-weight: 700;
    font-size: var(--step-1);
    line-height: 1.3;
    cursor: pointer;
    list-style: none;
    border-radius: var(--radius-m);
  }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__plus { width: 1.5rem; height: 1.5rem; flex: none; fill: none; stroke: var(--accent-ink); stroke-width: 2.6; stroke-linecap: round; transition: transform var(--dur-spring) var(--ease-spring); }
  .faq__item[open] .faq__plus { transform: rotate(45deg); }
  .faq__answer { padding: 0 1.25rem 1.25rem; color: var(--ink-soft); }
  @media (min-width: 60em) { .faq { grid-template-columns: 1fr 2fr; align-items: start; } .faq__head { position: sticky; top: calc(var(--nav-h) + 2rem); } }
</style>
