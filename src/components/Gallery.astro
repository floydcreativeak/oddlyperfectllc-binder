---
/**
 * Masonry wall of polaroids. Click to enlarge into an accessible lightbox
 * (native modal <dialog>: focus stays inside, Esc closes, arrows move,
 * alt text and captions included). Without JS the photos still show.
 */
import { getImage } from 'astro:assets';
import Photo from './Photo.astro';
import { resolveMedia } from '~/lib/content';
interface Props { items: { src: string; alt: string; caption?: string; placeholder?: boolean }[]; closeLabel: string; prevLabel: string; nextLabel: string }
const { items, closeLabel, prevLabel, nextLabel } = Astro.props;
const big = await Promise.all(items.map((it) => getImage({ src: resolveMedia(it.src), width: 1600, format: 'webp' })));
const tilts = [-2, 1.5, -1, 2, -1.5, 1];
---
<div class="gallery" data-gallery>
  <ul class="gallery__wall" role="list">
    {items.map((it, i) => (
      <li>
        <button type="button" class="gallery__btn" data-open={i} aria-label={`${it.alt}${it.caption ? ` (${it.caption})` : ''}`}>
          <Photo photo={it} frame="polaroid" sizes="(min-width: 60em) 22rem, (min-width: 36em) 45vw, 90vw" tilt={tilts[i % tilts.length]} />
        </button>
      </li>
    ))}
  </ul>
  <dialog class="lightbox" aria-label={items[0]?.alt ?? ''} data-lightbox>
    <figure class="lightbox__fig">
      <img alt="" data-lb-img />
      <figcaption class="hand" data-lb-cap></figcaption>
    </figure>
    <button type="button" class="lightbox__btn lightbox__prev" data-lb-prev aria-label={prevLabel}>&larr;</button>
    <button type="button" class="lightbox__btn lightbox__next" data-lb-next aria-label={nextLabel}>&rarr;</button>
    <button type="button" class="lightbox__btn lightbox__close" data-lb-close aria-label={closeLabel}>&times;</button>
    <script type="application/json" data-lb-data set:html={JSON.stringify(items.map((it, i) => ({ src: big[i].src, alt: it.alt, caption: it.caption ?? '' })))} />
  </dialog>
</div>

<script>
  function initGallery() {
    document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((g) => {
      if (g.dataset.ready) return;
      g.dataset.ready = '1';
      const dlg = g.querySelector<HTMLDialogElement>('[data-lightbox]')!;
      const img = dlg.querySelector<HTMLImageElement>('[data-lb-img]')!;
      const cap = dlg.querySelector<HTMLElement>('[data-lb-cap]')!;
      const data: { src: string; alt: string; caption: string }[] = JSON.parse(dlg.querySelector('[data-lb-data]')!.textContent || '[]');
      let i = 0;
      let opener: HTMLElement | null = null;
      const show = (n: number) => {
        i = (n + data.length) % data.length;
        img.src = data[i].src;
        img.alt = data[i].alt;
        cap.textContent = data[i].caption;
        dlg.setAttribute('aria-label', data[i].alt);
      };
      g.querySelectorAll<HTMLButtonElement>('[data-open]').forEach((b) =>
        b.addEventListener('click', () => {
          opener = b;
          show(Number(b.dataset.open));
          dlg.showModal();
        }),
      );
      dlg.querySelector('[data-lb-prev]')!.addEventListener('click', () => show(i - 1));
      dlg.querySelector('[data-lb-next]')!.addEventListener('click', () => show(i + 1));
      dlg.querySelector('[data-lb-close]')!.addEventListener('click', () => dlg.close());
      dlg.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') show(i - 1);
        if (e.key === 'ArrowRight') show(i + 1);
      });
      dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
      dlg.addEventListener('close', () => opener?.focus());
    });
  }
  document.addEventListener('astro:page-load', initGallery);
</script>

<style>
  .gallery__wall { columns: 1; column-gap: var(--space-l); padding: 0; margin: 0; list-style: none; }
  .gallery__wall li { break-inside: avoid; margin-bottom: var(--space-l); }
  .gallery__btn { display: block; width: 100%; cursor: zoom-in; border-radius: var(--radius-xs); }
  .gallery__btn:hover :global(.photo) { transform: rotate(0) translateY(var(--lift)); }
  @media (min-width: 36em) { .gallery__wall { columns: 2; } }
  @media (min-width: 60em) { .gallery__wall { columns: 3; } }
  .lightbox { max-width: min(92vw, 70rem); max-height: 92vh; padding: 0.8rem 0.8rem 2.6rem; border: 0; border-radius: var(--radius-xs); background: var(--surface); color: var(--ink); box-shadow: var(--shadow-3); overflow: visible; }
  .lightbox::backdrop { background: rgb(35 33 46 / 0.82); }
  .lightbox__fig img { max-width: 100%; max-height: calc(92vh - 4rem); width: auto; margin-inline: auto; }
  .lightbox__fig figcaption { position: absolute; left: 1rem; bottom: 0.5rem; font-size: 1.25rem; }
  .lightbox__btn { position: absolute; display: grid; place-items: center; width: 3rem; height: 3rem; border-radius: 50%; background: var(--note-butter); color: var(--note-ink); font-size: 1.6rem; font-weight: 700; box-shadow: var(--shadow-2); }
  .lightbox__close { top: -1.2rem; right: -1.2rem; }
  .lightbox__prev { left: -1.2rem; top: 50%; transform: translateY(-50%); }
  .lightbox__next { right: -1.2rem; top: 50%; transform: translateY(-50%); }
  @media (max-width: 40em) { .lightbox__prev { left: 0.3rem; } .lightbox__next { right: 0.3rem; } .lightbox__close { right: 0.3rem; top: 0.3rem; } }
</style>
