---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/home/Hero.astro';
import { getSite, getHome } from '~/lib/content';

const [site, home] = await Promise.all([getSite(), getHome()]);
---
<BaseLayout title={home.seo.title} description={home.seo.description} bareTitle>
  <Hero site={site} hero={home.hero} />
</BaseLayout>
