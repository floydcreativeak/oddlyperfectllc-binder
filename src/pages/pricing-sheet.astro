---
/**
 * Quick Pricing Sheet: the at-a-glance packet page, generated from
 * pricing.yml so it can never go stale. Designed for print (one page) and
 * for "Save as PDF".
 */
import '~/styles/fonts.css';
import '~/styles/tokens.css';
import '~/styles/base.css';
import ThemeScript from '~/components/ThemeScript.astro';
import { getPage, getPricing, getSite, getValues, formatPrice, fill, listFormat } from '~/lib/content';
import { link } from '~/lib/nav';
const [{ data: p }, pricing, site, values] = await Promise.all([getPage('pricing'), getPricing(), getSite(), getValues()]);
const f = (t: string) => fill(t, pricing, site);
const intro = pricing.partnershipsIntro;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <ThemeScript />
    <title>{p.sheetTitle} | {site.name}</title>
    <meta name="description" content={p.downloadBody} />
    <meta name="robots" content="noindex" />
    <link rel="icon" href={link('/favicon.svg')} type="image/svg+xml" />
  </head>
  <body>
    <div class="bar">
      <a href={link('/pricing')}>{p.sheetBackLabel}</a>
      <button type="button" class="btn" data-print>{p.sheetPrintLabel}</button>
    </div>
    <main class="sheet">
      <header class="sheet__head">
        <div>
          <p class="sheet__name">{site.name}</p>
          <h1>{p.sheetTitle}</h1>
        </div>
        <p class="sheet__contact">
          <strong data-placeholder={site.phone.placeholder ? 'phone' : undefined}>{site.phone.display}</strong><br />
          <span data-placeholder={site.email.placeholder ? 'email' : undefined}>{site.email.address}</span><br />
          {site.region}
        </p>
      </header>

      <section>
        <h2>{intro.heading}</h2>
        <table>
          <thead><tr><th scope="col"><span class="visually-hidden">{intro.heading}</span></th><th scope="col">{intro.flexLabel}</th><th scope="col">{intro.monthlyLabel}</th></tr></thead>
          <tbody>
            {pricing.partnerships.map((x) => (
              <tr><th scope="row">{x.name}<span class="fit">{x.fitLine}</span></th><td>{formatPrice(x.flexPrice)}{intro.perMonth}</td><td>{formatPrice(x.monthlyPrice)}{intro.perMonth}</td></tr>
            ))}
          </tbody>
        </table>
        <p class="small"><strong>{pricing.flex.name}:</strong> {pricing.flex.tagline} {pricing.flex.benefits.map(f).join('; ')}.</p>
      </section>

      <div class="cols">
        <section>
          <h2>{pricing.projectsIntro.heading}</h2>
          <table><tbody>{pricing.projects.map((x) => <tr><th scope="row">{x.name}</th><td>{formatPrice(x.price)}</td></tr>)}</tbody></table>
        </section>
        <section>
          <h2>{pricing.eventsIntro.heading}</h2>
          <table><tbody>{pricing.events.map((x) => <tr><th scope="row">{x.name}</th><td>{formatPrice(x.price)}</td></tr>)}</tbody></table>
        </section>
      </div>

      <div class="cols">
        <section>
          <h2>{p.feesHeading}</h2>
          <table><tbody>{pricing.fees.map((x) => <tr><th scope="row">{x.name}</th><td>{formatPrice(x.price)}</td></tr>)}</tbody></table>
        </section>
        <section>
          <h2>{p.rushHeading}</h2>
          <table><tbody>
            {pricing.rush.rows.map((r) => <tr><th scope="row">{r.when}</th><td>+{r.surcharge}%</td></tr>)}
            {pricing.eventRush.rows.map((r) => <tr><th scope="row">{r.when}</th><td>+{r.surcharge}%{r.note ? ` ${r.note}` : ''}</td></tr>)}
          </tbody></table>
        </section>
      </div>

      <section>
        <h2>{p.sheetKeyPolicies}</h2>
        <ul class="policies">
          {values.promises.map((v) => <li><strong>{v.title}</strong> {v.closing}</li>)}
          <li><strong>{f(pricing.communityRate.headline)}.</strong> {pricing.communityRate.rules.join(' ')}</li>
          <li><strong>{pricing.revisionRule.heading}:</strong> {pricing.revisionRule.points.map(f).join(' ')}</li>
          <li><strong>{pricing.travel.heading}:</strong> {pricing.travel.localLine} {listFormat(site.serviceArea)}. {f(pricing.travel.terms[1] ?? '')}</li>
          <li>{pricing.feesFootnote}</li>
          <li>{p.policiesNote}</li>
        </ul>
      </section>
    </main>
    <script>
      document.querySelector('[data-print]')?.addEventListener('click', () => window.print());
    </script>
  </body>
</html>

<style>
  body { background: var(--paper); }
  .bar { display: flex; justify-content: space-between; align-items: center; gap: 1rem; max-width: 52rem; margin: 1rem auto 0; padding: 0 var(--gutter); }
  .bar a { display: inline-flex; align-items: center; min-height: var(--tap); color: var(--accent-ink); font-weight: 700; }
  .sheet { max-width: 52rem; margin: 1rem auto 3rem; padding: clamp(1.1rem, 4vw, 2rem) clamp(1rem, 4vw, 2.25rem); background: var(--surface); border-radius: var(--radius-m); box-shadow: var(--shadow-2); font-size: 0.86rem; line-height: 1.4; }
  .sheet__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 1rem; padding-bottom: 0.8rem; border-bottom: 3px solid var(--accent); }
  .sheet__name { font-family: var(--font-hand); font-size: 1.2rem; color: var(--accent-ink); }
  h1 { font-size: 2.2rem; }
  .sheet__contact { text-align: right; font-size: 0.85rem; }
  h2 { font-size: 1.15rem; margin: 1.1rem 0 0.35rem; }
  table { width: 100%; border-collapse: collapse; }
  th, td { padding: 0.28rem 0; text-align: left; border-bottom: 1px dotted var(--line); vertical-align: top; }
  td { text-align: right; font-weight: 700; white-space: nowrap; padding-left: 0.75rem; font-variant-numeric: tabular-nums; }
  thead th { font-weight: 700; font-size: 0.78rem; text-align: right; }
  th[scope='row'] { font-weight: 600; }
  .fit { display: block; font-weight: 400; color: var(--ink-soft); font-size: 0.78rem; }
  .small { margin-top: 0.4rem; font-size: 0.8rem; max-width: none; }
  .cols { display: grid; gap: 0 2rem; }
  @media (min-width: 40em) { .cols { grid-template-columns: 1fr 1fr; } }
  .policies { display: grid; gap: 0.25rem; padding-left: 1.1rem; font-size: 0.8rem; }
  @media print {
    @page { size: letter; margin: 0.45in; }
    html, body { background: none; color: #2b2a33; }
    .bar { display: none; }
    .sheet { margin: 0; padding: 0; box-shadow: none; background: none; max-width: none; font-size: 9pt; }
    .cols { grid-template-columns: 1fr 1fr; }
    h1 { font-size: 20pt; }
    h2 { font-size: 11pt; margin-top: 8pt; break-after: avoid; }
    section { break-inside: avoid; }
  }
</style>
